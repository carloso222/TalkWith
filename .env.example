# Copia este archivo como .env y llena los valores de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Web).
# El archivo .env NUNCA se sube al repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = usar Firebase Emulator Suite local (npx firebase emulators:start)
VITE_USE_EMULATORS=true

# URL del servidor Socket.io de TW 05 (Isaian)
VITE_SOCKET_URL=http://localhost:3000
